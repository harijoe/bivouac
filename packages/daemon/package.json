{
  "name": "@bivouac/daemon", "version": "0.1.0", "type": "module", "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
