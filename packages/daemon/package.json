    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.5.0",
    "dockerode": "^4.0.2",
    "hono": "^4.6.0"
  },
  "devDependencies": { "@types/better-sqlite3": "^7.6.11", "@types/dockerode": "^3.3.31", "@types/node": "^22.0.0" }
}
